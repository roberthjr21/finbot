# Números que siempre pueden usar el bot (el propietario): con indicativo de país, sin + ni espacios.
# Varios separados por comas. Con REGISTRO_ABIERTO=1 cualquier persona que escriba recibe su propia cuenta.
NUMEROS_PERMITIDOS=573001234567
# 1 (por defecto): cualquier número nuevo obtiene cuenta al escribir. 0: solo los de NUMEROS_PERMITIDOS.
# REGISTRO_ABIERTO=1
# Números que el bot ignora siempre (separados por comas).
# NUMEROS_BLOQUEADOS=
# Límites por persona (valores por defecto).
# MAX_MENSAJES_MINUTO=20
# MAX_MENSAJES_DIA=300
# MAX_IA_DIA=150
# Clave para guardar los códigos de acceso web; si falta se usa API_TOKEN.
# SECRETO_SESION=

# Clave de la API de Anthropic (se crea en console.anthropic.com).
# Si la dejas vacía, el bot solo entiende comandos (/gasto, /resumen...).
ANTHROPIC_API_KEY=
MODELO_IA=claude-haiku-5-5
# Modelo de Gemini que se prueba si el principal falla (déjalo vacío para desactivarlo).
# MODELO_RESPALDO=gemini-flash-lite-latest

# API para tu página web (opcional). Sin API_TOKEN queda desactivada.
API_TOKEN=cambia-esto-por-una-clave-larga-y-secreta
API_PUERTO=3001
ORIGEN_PERMITIDO=http://localhost:3000

# Archivo de la base de datos (por defecto finanzas.db en esta carpeta)
# DB_ARCHIVO=finanzas.db

# Límite máximo permitido por movimiento y presupuesto, en pesos COP.
MONTO_MAXIMO=100000000

# Opciones adicionales del bot (opcionales).
DEBUG=0
MODO_AUTOCHAT=0
ESPERA_RECONEXION_MS=3000
API_HOST=127.0.0.1
GEMINI_API_KEY=
GEMINI_URL=
ANTHROPIC_URL=
MODELO_GEMINI=
MODELO_ANTHROPIC=
