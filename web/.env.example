# Variables del servidor de Next.js. NUNCA uses el prefijo NEXT_PUBLIC_ con ellas.
# Local: cópialas a web/.env.local. Vercel: Project Settings > Environment Variables.

# Dirección del API del bot.
#  - Local: http://127.0.0.1:3001
#  - Vercel: una URL HTTPS pública que llegue al bot (túnel o servidor), sin barra final ni parámetros.
#    127.0.0.1 en Vercel apunta a Vercel, no a tu computador.
BOT_API_URL=

# Clave del API: debe ser EXACTAMENTE la API_TOKEN del .env del bot. Larga y aleatoria. Privada.
BOT_API_TOKEN=

# Ya no existen DASHBOARD_USER ni DASHBOARD_PASSWORD: el acceso es con código por WhatsApp.

# Origen público exacto para CSRF (esquema + dominio + puerto si aplica).
# Obligatorio en producción propia. En Vercel puede usar VERCEL_URL si no se configura.
# Configúralo explícitamente para dominios personalizados y cada preview autorizada.
WEB_ORIGEN=http://localhost:3000

# Sin Vercel no se confía en cabeceras de IP por defecto (límite global conservador).
# Solo para web detrás de Cloudflare Tunnel + gateway autenticado:
# PROXY_IP=cloudflare
# PROXY_SECRETO=
# El gateway debe sobrescribir X-Finbot-Proxy con este secreto privado de 32+ caracteres,
# conservar CF-Connecting-IP de Cloudflare e impedir accesos directos al origen.
# No envíes este secreto al navegador. Vercel usa su X-Forwarded-For sobrescrito.
